PORT=3000
CORS_ORIGIN=http://localhost:4200
PGHOST=localhost
PGPORT=5432
PGDATABASE=tienda_modular
PGUSER=postgres
PGPASSWORD=CAMBIAR_POR_LA_CLAVE_LOCAL
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
# PGSSL_CA_PATH=C:\ruta\certificado-ca.pem
# Obligatorio en produccion: cadena aleatoria larga (por ejemplo: openssl rand -hex 32)
CSRF_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO
# true habilita HTTPS local con HTTPS_KEY_PATH y HTTPS_CERT_PATH (no subir certificados privados)
HTTPS_ENABLED=false
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
